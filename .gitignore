# Copy to .env and fill in. NEVER commit the real .env.
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PLANTRACK_SECRET_KEY=replace-with-a-strong-random-secret
PLANTRACK_ENV=production
# Comma-separated browser origins allowed to call the API:
PLANTRACK_ALLOWED_ORIGINS=https://plantrack.example.com

POSTGRES_USER=plantrack
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=plantrack

# Optional
WEB_CONCURRENCY=3
PLANTRACK_SCAN_INTERVAL_S=300
SENTRY_DSN=